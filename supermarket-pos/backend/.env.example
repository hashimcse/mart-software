# Server
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://pos_user:pos_password@localhost:5432/pos_db?schema=public"

# Auth
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Backups (0 disables scheduling; use 24 for daily backups)
BACKUP_INTERVAL_HOURS=0
BACKUP_DIR=backups
# Windows example; omit when PostgreSQL tools are on PATH
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
# Clean-store seed: set INITIAL_ADMIN_PASSWORD (12+ characters)
# Demo seed only: SEED_DEMO=true
