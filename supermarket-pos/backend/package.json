{
  "name": "pos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Supermarket POS - Backend API (Phase 1: architecture, database, authentication)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-client.cjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "verify:auth": "ts-node --transpile-only scripts/verify-auth-primitives.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.10.0",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
